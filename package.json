{
  "name": "beef-chain-simulator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "assistant:dev": "wrangler dev --config wrangler.assistant.jsonc --env preview --local",
    "assistant:dry-run": "wrangler deploy --config wrangler.assistant.jsonc --dry-run --outdir dist/assistant-worker",
    "assistant:deploy:preview": "wrangler deploy --config wrangler.assistant.jsonc --env preview",
    "assistant:deploy": "wrangler deploy --config wrangler.assistant.jsonc",
    "assistant:db:local": "wrangler d1 migrations apply ASSISTANT_DB --local --env preview --config wrangler.assistant.jsonc",
    "assistant:db:preview": "wrangler d1 migrations apply ASSISTANT_DB --remote --env preview --config wrangler.assistant.jsonc",
    "assistant:db:production": "wrangler d1 migrations apply ASSISTANT_DB --remote --config wrangler.assistant.jsonc",
    "data:refresh": "node scripts/data/refresh-historical-data.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/openai": "^4.0.70",
    "@ai-sdk/provider-utils": "^5.0.44",
    "@ai-sdk/react": "^4.0.109",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "ai": "^7.0.106",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
